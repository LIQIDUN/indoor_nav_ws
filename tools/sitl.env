# indoor_nav_ws/tools/sitl.env
# Gazebo Classic 11 (SwiftGust/khancyr ArduPilotPlugin) + ArduPilot binary gazebo backend.
AP_ROOT="$HOME/github/ardupilot"
GAZEBO_ROOT="$HOME/github/ardupilot_gazebo"
WORLD_FILE="$GAZEBO_ROOT/worlds/iris_ardupilot.world"
SITL_FRAME="gazebo-iris"
# IMPORTANT: Gazebo Classic plugin uses binary protocol; JSON is for modern Gazebo Sim.
SITL_MODEL="gazebo"
GAZEBO_MODEL_NAME="iris"
GAZEBO_GUI="true"
MAVROS_UDP_PORT="14552"
START_QGC="1"
QGC_APP="$HOME/appimage/QGroundControl.AppImage"
EXTERNAL_NAV_ENABLED="true"
UWB_NOISE_STD_XY_M="0.0"
UWB_DELAY_MS="0"
# Options: auto, terminator, gnome-terminal. auto prefers Terminator.
TERMINAL_APP="auto"
# Extra commandline switches for SITL, if desired; defaults keep console and map OFF
SITL_CONSOLE="false"
SITL_MAP="false"
# legacy session name for diagnostic purposes only
TMUX_SESSION="indoor_uwb_sitl"
