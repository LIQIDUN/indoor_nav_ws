<launch>
  <arg name="mission_file" default="$(find indoor_nav)/config/mission_v0.yaml"/>
  <arg name="enable_control" default="false"/>
  <arg name="dry_run" default="true"/>
  <arg name="evidence_dir" default="$(env HOME)/.ros/v0_nav"/>
  <node pkg="indoor_nav" type="relative_mission_manager.py" name="v0_nav_manager" output="screen">
    <param name="mission_file" value="$(arg mission_file)"/>
    <param name="enable_control" value="$(arg enable_control)"/>
    <param name="dry_run" value="$(arg dry_run)"/>
    <param name="evidence_dir" value="$(arg evidence_dir)"/>
  </node>
  <node pkg="indoor_nav" type="v0_nav_health.py" name="v0_nav_watchdog" output="screen"/>
</launch>
